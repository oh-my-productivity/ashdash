# Pinned third-party tools used by the release scripts. Sourced by install-git-cliff.sh and checked by lib.sh.
# To update: change the version, download the two archives named below from
#   https://github.com/orhun/git-cliff/releases/tag/v<version>
# compare `shasum -a 256` of each with the published .sha512 file (`shasum -a 512`), and paste the SHA-256 values here.
# shellcheck shell=bash

