#!/usr/bin/env bash
# lab-gc [--max-age SECS]   Watchdog: delete ashdash-run-* VMs older than 30 min (LAB_MAX_VM_AGE).
# lab-up runs it before every clone; run it by hand after a crash. Never touches other VMs.
set -euo pipefail
# shellcheck source=lib.sh
. "$(dirname "$0")/lib.sh"
max=$LAB_MAX_VM_AGE
while [ $# -gt 0 ]; do
  case "$1" in
    --max-age) max=$2; shift 2 ;;
    -h|--help) sed -n '2,3p' "$0"; exit 0 ;;
    *) lab_die "unknown argument: $1" ;;
  esac
done
lab_need_tart
for vm in $("$TART_BIN" list --source local --quiet 2>/dev/null | grep "^${LAB_PREFIX}" || true); do
  age=$(lab_vm_age "$vm")
  if [ "$age" -gt "$max" ]; then
    lab_log "watchdog: $vm is ${age}s old (> ${max}s): deleting"
    "$LAB_DIR/lab-down" "$vm" || true
  fi
done
