#!/usr/bin/env bash
# lab-smoke [--quick] [--no-gui] [--artifacts DIR]
# One-shot: boot a lab VM, run tests/lab/smoke.sh in it, copy results to DIR (default lab-out/<timestamp>,
# git-ignored), delete the VM. Prints the report; exit status 1 if a stage FAILed.
set -euo pipefail
# shellcheck source=lib.sh
. "$(dirname "$0")/lib.sh"
out="" smoke_args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --artifacts) out=$2; shift 2 ;;
    --quick|--no-gui) smoke_args+=("$1"); shift ;;
    -h|--help) sed -n '2,5p' "$0"; exit 0 ;;
    *) lab_die "unknown option: $1" ;;
  esac
done
[ -n "$out" ] || out="$LAB_REPO_ROOT/lab-out/$(date +%Y%m%d-%H%M%S)"
mkdir -p "$out"
rc=0
"$LAB_DIR/lab-with-vm" --artifacts "$out" ${LAB_AUTO_TCC:+--env "LAB_AUTO_TCC=$LAB_AUTO_TCC"} -- bash tests/lab/smoke.sh "${smoke_args[@]+"${smoke_args[@]}"}" || rc=$?
lab_log "artifacts in $out (screenshots: view, then delete; never commit)"
exit "$rc"
