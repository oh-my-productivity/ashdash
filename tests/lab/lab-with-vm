#!/usr/bin/env bash
# lab-with-vm [--artifacts DIR] [--id ID] [--image NAME] [--env K=V]... [--no-sync] -- <cmd> [args...]
#
# One-shot lab job: lab-up, lab-run <cmd> inside the VM, lab-down. A trap guarantees the VM is
# deleted and its slot released on success, failure, Ctrl-C or SIGTERM (only SIGKILL of this script
# escapes it; the 30-minute watchdog in lab-gc/lab-up then reaps the VM). Exit code = the command's.
set -euo pipefail
# shellcheck source=lib.sh
. "$(dirname "$0")/lib.sh"

up_args=() run_args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --id|--image|--queue-timeout) up_args+=("$1" "$2"); shift 2 ;;
    --artifacts|--env|--src) run_args+=("$1" "$2"); shift 2 ;;
    --no-sync) run_args+=("$1"); shift ;;
    --) shift; break ;;
    -h|--help) sed -n '2,7p' "$0"; exit 0 ;;
    *) lab_die "unknown option: $1 (put the command after --)" ;;
  esac
done
[ $# -gt 0 ] || lab_die "usage: lab-with-vm [options] -- <cmd> [args...]"

vm=""
# shellcheck disable=SC2329  # invoked through the EXIT trap
cleanup() {
  local rc=$?
  trap - EXIT INT TERM HUP
  if [ -n "$vm" ]; then "$LAB_DIR/lab-down" "$vm" >&2 || { [ "$rc" -ne 0 ] || rc=1; }; fi
  exit "$rc"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

# Decide the name up front so the trap can clean up even if lab-up is interrupted mid-way.
id=""
for ((i = 0; i < ${#up_args[@]}; i++)); do
  [ "${up_args[i]}" = "--id" ] && id=${up_args[i + 1]}
done
if [ -z "$id" ]; then
  id="$(date +%H%M%S)-$$-$RANDOM"
  up_args+=(--id "$id")
fi
vm="${LAB_PREFIX}${id}"
lab_check_run_name "$vm"

out=$("$LAB_DIR/lab-up" "${up_args[@]}")
read -r vm_name ip <<<"$out"
lab_log "lab VM $vm_name at $ip"
rc=0
"$LAB_DIR/lab-run" "$vm_name" "${run_args[@]+"${run_args[@]}"}" -- "$@" || rc=$?
exit "$rc"
